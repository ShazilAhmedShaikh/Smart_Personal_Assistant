# ==============================================================
# J.A.R.V.I.S. Local Assistant - Environment Configuration
# ==============================================================

# Server Network Settings
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_DEBUG=True

# Google Gemini API Key (Required for full conversational reasoning)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional: ElevenLabs TTS API (For hyper-realistic British voice)
# Get your key & voice ID at: https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Local Machine Directories
PROJECTS_DIR=C:\Shazil\projects
VAULT_DIR=C:\Shazil\projects\testing
